#!/bin/sh
#MISE description="Verify isolated dynamic bootstrap behavior with and without a GitHub user."
set -eu

repo_root="$(CDPATH= cd -P -- "$MISE_TASK_DIR/../../../../.." && pwd)"
bootstrap="$repo_root/home/.config/mise/tasks/bootstrap"
fixture_home="$(mktemp -d)"
trap 'rm -rf "$fixture_home"' EXIT

git() {
    if [ "${1:-}" = version ]; then
        printf '%s\n' 'git version 2.54.0'
    else
        command git "$@"
    fi
}
hk() { :; }
fnox() { printf '%s\n' '# fixture fnox'; }
starship() { printf '%s\n' '# fixture starship'; }
wt() { printf '%s\n' '# fixture wt'; }
launchctl() { :; }
gh() { :; }
mise() {
    case "${1:-} ${2:-}" in
        'activate nu') printf '%s\n' '# fixture mise activation' ;;
        'env --json') printf '%s\n' '{"PATH":"/fixture/bin"}' ;;
        'env --dotenv') printf '%s\n' 'FIXTURE_ENV=value' ;;
        *) return 1 ;;
    esac
}
curl() {
    url=''
    for arg in "$@"; do url=$arg; done
    case "$url" in
        'https://api.github.com/users/fixture-user')
            printf '%s\n' '{"id":7,"login":"fixture-user","name":"Fixture User"}'
            ;;
        'https://github.com/fixture-user.keys')
            printf '%s\n' 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFixture fixture@example'
            ;;
        *) return 1 ;;
    esac
}

HOME="$fixture_home"
export HOME
fixture_bin="$fixture_home/bin"
mkdir -p "$fixture_bin" "$HOME/.config/git" "$HOME/.config/nushell" "$HOME/.ssh"
ln -s /usr/bin/true "$fixture_bin/ssh-keyscan"
PATH="$fixture_bin:$PATH"
export PATH

GITHUB_USER=
export GITHUB_USER
. "$bootstrap"

[ ! -e "$HOME/.config/git/user" ] ||
    { echo "bootstrap must not write Git identity without a GitHub user" >&2; exit 1; }
[ -s "$HOME/.config/nushell/env.nu" ] ||
    { echo "bootstrap must generate the Nushell environment module" >&2; exit 1; }
[ -s "$HOME/.config/nushell/config.nu" ] ||
    { echo "bootstrap must generate the Nushell config module" >&2; exit 1; }

GITHUB_USER=fixture-user
export GITHUB_USER
. "$bootstrap"

grep -Fq 'name = "Fixture User"' "$HOME/.config/git/user" ||
    { echo "bootstrap must derive the Git user name" >&2; exit 1; }
grep -Fq 'email = "7+fixture-user@users.noreply.github.com"' "$HOME/.config/git/user" ||
    { echo "bootstrap must derive the Git noreply email" >&2; exit 1; }
grep -Fq 'fixture-user ssh-ed25519' "$HOME/.ssh/allowed_signers" ||
    { echo "bootstrap must derive allowed signers from GitHub keys" >&2; exit 1; }
grep -Fq 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFixture' "$HOME/.ssh/authorized_keys" ||
    { echo "bootstrap must refresh authorized keys from GitHub" >&2; exit 1; }
grep -Fq '# fixture mise activation' "$HOME/.config/nushell/env.nu" ||
    { echo "bootstrap must retain generated Nushell mise activation" >&2; exit 1; }

echo "dynamic bootstrap fixtures passed"
