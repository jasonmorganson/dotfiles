#!/bin/sh
#MISE description="Verify zsh bootstrap ownership and ordering."
set -eu

repo_root="$(CDPATH= cd -P -- "$MISE_TASK_DIR/../../../../.." && pwd)"
dotfiles="$repo_root/home/.config/mise/conf.d/30-dotfiles.toml"
github="$repo_root/home/.config/mise/tasks/github"
bootstrap_config="$repo_root/home/.config/mise/conf.d/20-bootstrap.toml"
environment_config="$repo_root/home/.config/mise/conf.d/40-env.toml"
aliases_config="$repo_root/home/.config/mise/conf.d/50-aliases.toml"
mise_config="$repo_root/home/.config/mise/config.toml"

grep -Fq '"~/.zshrc/local"' "$dotfiles" ||
    { echo "generated zsh integrations must be sourced from the standard zshrc" >&2; exit 1; }

if grep -Fq '"~/.config/zsh/.zshrc"' "$dotfiles"; then
    echo "the legacy ZDOTDIR zshrc must not be managed" >&2
    exit 1
fi

if grep -Fq 'render_shell()' "$github" || grep -Fq '> "$HOME/.config/zsh/rc"' "$github"; then
    echo "GitHub refresh must not generate POSIX shell integration files" >&2
    exit 1
fi
grep -Fq '"brew:git" = "latest"' "$bootstrap_config" ||
    { echo "mise must declaratively manage Git through its Homebrew integration" >&2; exit 1; }
grep -Fq 'hk install --global --mise' "$bootstrap_config" ||
    { echo "mise must install global hk hooks after tools are available" >&2; exit 1; }
grep -Fq 'mise exec -- hk install --global --mise' "$bootstrap_config" ||
    { echo "hk setup must invoke mise through the controlled environment" >&2; exit 1; }
grep -Fq 'Darwin) brew_prefix=/opt/homebrew' "$bootstrap_config" ||
    { echo "hk setup must select the managed macOS Git path" >&2; exit 1; }
grep -Fq 'Linux) brew_prefix=/home/linuxbrew/.linuxbrew' "$bootstrap_config" ||
    { echo "hk setup must select the managed Linux Git path" >&2; exit 1; }
if grep -Fq 'MISE_BIN=' "$bootstrap_config"; then
    echo "hk setup must not encode mise's installation path" >&2
    exit 1
fi
if grep -Eq 'git_is_modern|brew install git|hk install --global --mise' "$github"; then
    echo "GitHub refresh must not manage Git or hk" >&2
    exit 1
fi
grep -Fq 'hk = "latest"' "$repo_root/home/.config/mise/conf.d/10-tools.toml" ||
    { echo "mise must manage hk" >&2; exit 1; }
grep -Fq 'min_version = "2026.9.5"' "$mise_config" ||
    { echo "mise config must require the declarative bootstrap release" >&2; exit 1; }
grep -Fq 'auto_update = true' "$mise_config" ||
    { echo "mise must keep its standalone installation current" >&2; exit 1; }
grep -Fq 'dotfiles = "mise bootstrap --update --yes --force-dotfiles"' "$aliases_config" ||
    { echo "dotfiles alias must update repositories and reapply the machine configuration" >&2; exit 1; }
if grep -Eq '^bootstrap[[:space:]]*=' "$aliases_config"; then
    echo "bootstrap compatibility alias must be removed" >&2
    exit 1
fi

if grep -Fq '[bootstrap.mise_shell_activate]' "$bootstrap_config"; then
    echo "zsh activation must be explicitly ordered through dotfiles" >&2
    exit 1
fi
grep -Fq '"~/.zprofile/activate" = { line = '\''eval "$(mise activate zsh --shims)"'\'', position = "prepend" }' "$dotfiles" || exit 1
grep -Fq '"~/.zshrc/activate" = { line = '\''eval "$(mise activate zsh)"'\'', position = "prepend" }' "$dotfiles" || exit 1

if grep -Eq 'launchctl|mise env' "$github"; then
    echo "GitHub refresh must not publish mise environment to the macOS GUI session" >&2
    exit 1
fi

if grep -Fq 'node = "node --experimental-transform-types"' "$aliases_config"; then
    echo "node must not be wrapped by a shell alias" >&2
    exit 1
fi

grep -Fq '"{{ env.NPM_CONFIG_PREFIX }}/bin"' "$environment_config" ||
    { echo "mise PATH must include npm's configured global bin directory" >&2; exit 1; }

grep -Fq '"{{ env.XDG_DATA_HOME }}/pnpm/bin"' "$environment_config" ||
    { echo "mise PATH must include pnpm's global bin directory" >&2; exit 1; }

grep -Fq '"/home/linuxbrew/.linuxbrew/bin"' "$environment_config" ||
    { echo "mise PATH must include the canonical Linuxbrew prefix" >&2; exit 1; }

echo "zsh bootstrap ordering fixtures passed"
