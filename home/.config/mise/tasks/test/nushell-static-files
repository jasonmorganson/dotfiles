#!/bin/sh
#MISE description="Verify tracked Nushell configuration regenerates runtime integrations."
#MISE tools={nu="latest"}
set -eu

repo_root="$(CDPATH= cd -P -- "$MISE_TASK_DIR/../../../../.." && pwd)"
fixture_root="$(mktemp -d)"
trap 'rm -rf "$fixture_root"' EXIT

fixture_config="$fixture_root/config/nushell"
fixture_data="$fixture_root/data"
fixture_bin="$fixture_root/bin"
mkdir -p "$fixture_config" "$fixture_bin"
cp "$repo_root/home/.config/nushell/env.nu" "$fixture_config/env.nu"
cp "$repo_root/home/.config/nushell/config.nu" "$fixture_config/config.nu"
for tool in mise starship fnox wt; do
    ln -s "$repo_root/home/.config/mise/tasks/test/fixtures/nushell-tool" "$fixture_bin/$tool"
done

run_nu() {
    env \
        XDG_DATA_HOME="$fixture_data" \
        PATH="$fixture_bin:$PATH" \
        NU_FIXTURE_VERSION="$1" \
        nu -l --no-history --config-home "$fixture_config" -c '$env.MISE_FIXTURE' >/dev/null
    env \
        XDG_DATA_HOME="$fixture_data" \
        nu --no-config-file --no-history -c "
            source '$fixture_config/mise.nu'
            source '$fixture_config/autoload/fnox.nu'
            source '$fixture_config/autoload/wt.nu'
            source '$fixture_data/nushell/vendor/autoload/starship.nu'
            [\$env.MISE_FIXTURE \$env.STARSHIP_FIXTURE (fnox) (wt)] | each { print }
        "
}

first_output="$(run_nu one)"
printf '%s\n' "$first_output" | grep -Fq one
printf '%s\n' "$first_output" | grep -Fq fnox-one
printf '%s\n' "$first_output" | grep -Fq wt-one

[ -s "$fixture_config/mise.nu" ] || exit 1
[ -s "$fixture_config/autoload/fnox.nu" ] || exit 1
[ -s "$fixture_config/autoload/wt.nu" ] || exit 1
[ -s "$fixture_data/nushell/vendor/autoload/starship.nu" ] || exit 1

second_output="$(run_nu two)"
printf '%s\n' "$second_output" | grep -Fq two
printf '%s\n' "$second_output" | grep -Fq fnox-two
printf '%s\n' "$second_output" | grep -Fq wt-two
grep -Fq 'two' "$fixture_config/mise.nu"
grep -Fq 'two' "$fixture_data/nushell/vendor/autoload/starship.nu"

echo "Nushell static configuration fixtures passed"
