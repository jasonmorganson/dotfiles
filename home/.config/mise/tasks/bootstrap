#!/bin/sh
#MISE description="Refresh dynamic GitHub identity and signing keys after mise tools are installed."
set -eu

if [ -z "${GITHUB_USER:-}" ]; then
    GITHUB_USER=$(gh api user --jq 'select(.type == "User") | .login' 2>/dev/null) || GITHUB_USER=
fi
if [ -n "$GITHUB_USER" ]; then
    gh api "users/${GITHUB_USER}" --jq '
        "[user]",
        "    name = \((.name // .login) | @json)",
        "    email = \(((.id | tostring) + "+" + .login + "@users.noreply.github.com") | @json)"
    ' > ~/.config/git/user

    signing_keys=$(gh api --paginate "users/${GITHUB_USER}/ssh_signing_keys" --jq '.[].key')
    printf '%s' "$signing_keys" | sed "s/^/${GITHUB_USER} /" > ~/.ssh/allowed_signers
fi
