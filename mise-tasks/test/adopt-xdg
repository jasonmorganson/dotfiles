#!/bin/sh
#MISE description="Verify adoption into a caller-selected XDG configuration directory."
set -eu

repo_root="$(CDPATH= cd -P -- "$MISE_TASK_DIR/../.." && pwd)"
fixture_root="$(mktemp -d)"
trap 'rm -rf "$fixture_root"' EXIT

git clone --quiet --no-local "$repo_root" "$fixture_root/source"
mkdir -p "$fixture_root/home" "$fixture_root/xdg-config"

env \
    -u MISE_CONFIG_DIR \
    -u MISE_SHELL \
    -u __MISE_DIFF \
    -u __MISE_SESSION \
    HOME="$fixture_root/home" \
    XDG_CONFIG_HOME="$fixture_root/xdg-config" \
    MISE_DATA_DIR="$fixture_root/mise-data" \
    mise bootstrap --adopt "file://$fixture_root/source" --only task --yes

test -f "$fixture_root/xdg-config/mise/config.toml"
test -d "$fixture_root/xdg-config/mise/mise-tasks"
if grep -Fq '[task_config]' "$fixture_root/xdg-config/mise/config.toml"; then
    echo "adopted config must use mise's default file-task discovery" >&2
    exit 1
fi

env \
    -u MISE_CONFIG_DIR \
    -u MISE_SHELL \
    -u __MISE_DIFF \
    -u __MISE_SESSION \
    HOME="$fixture_root/home" \
    XDG_CONFIG_HOME="$fixture_root/xdg-config" \
    MISE_DATA_DIR="$fixture_root/mise-data" \
    mise tasks ls --hidden | grep -Fq 'test:install'

echo "XDG adoption fixture passed"
