#!/bin/sh
#MISE description="Verify isolated dynamic bootstrap behavior with and without a GitHub user."
set -eu

repo_root="$(CDPATH= cd -P -- "$MISE_TASK_DIR/../.." && pwd)"
github="$repo_root/mise-tasks/github"
if grep -Fq '\\"@users.noreply.github.com\\"' "$github"; then
    echo "GitHub refresh must pass valid jq quoting to gh" >&2
    exit 1
fi
fixture_home="$(mktemp -d)"
trap 'rm -rf "$fixture_home"' EXIT

gh() {
    endpoint=''
    for arg in "$@"; do
        case "$arg" in
            user|users/*) endpoint=$arg ;;
        esac
    done
    case "$endpoint" in
        user) return 1 ;;
        users/fixture-user)
            printf '%s\n' '[user]' '    name = "Fixture User"' \
                '    email = "7+fixture-user@users.noreply.github.com"'
            ;;
        users/fixture-user/ssh_signing_keys)
            printf '%s\n' 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFixture fixture@example'
            ;;
        *) return 1 ;;
    esac
}

mise() {
    if [ "$1" = exec ] && [ "$2" = -- ]; then
        shift 2
        "$@"
        return
    fi
    return 1
}

HOME="$fixture_home"
export HOME
fixture_bin="$fixture_home/bin"
mkdir -p "$fixture_bin" "$HOME/.config/git" "$HOME/.ssh"
printf '%s\n' 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExisting existing@example' > "$HOME/.ssh/authorized_keys"
PATH="$fixture_bin:$PATH"
export PATH

GITHUB_USER=
export GITHUB_USER
. "$github"

[ ! -e "$HOME/.config/git/user" ] ||
    { echo "bootstrap must not write Git identity without a GitHub user" >&2; exit 1; }

GITHUB_USER=fixture-user
export GITHUB_USER
. "$github"

grep -Fq 'name = "Fixture User"' "$HOME/.config/git/user" ||
    { echo "bootstrap must derive the Git user name" >&2; exit 1; }
grep -Fq 'email = "7+fixture-user@users.noreply.github.com"' "$HOME/.config/git/user" ||
    { echo "bootstrap must derive the Git noreply email" >&2; exit 1; }
if grep -Fq 'signingkey' "$HOME/.config/git/user"; then
    echo "bootstrap must not write static signing configuration" >&2
    exit 1
fi
grep -Fq 'fixture-user ssh-ed25519' "$HOME/.ssh/allowed_signers" ||
    { echo "bootstrap must derive allowed signers from GitHub signing keys" >&2; exit 1; }
grep -Fq 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExisting' "$HOME/.ssh/authorized_keys" ||
    { echo "GitHub refresh must not manage authorized keys" >&2; exit 1; }
echo "GitHub refresh fixtures passed"
